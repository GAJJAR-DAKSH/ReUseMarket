# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (Atlas or Local MongoDB)
# Example Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/reusemarket?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/reusemarket

# Authentication
JWT_SECRET=your_jwt_secret_key_minimum_32_characters

# Client URL for CORS and verification redirects
CLIENT_URL=http://localhost:5173

# Allowed College Email Domains (comma-separated or suffix match)
# e.g., '.edu,.ac.in,campus.edu' or '*' to allow any domain in dev
ALLOWED_COLLEGE_EMAIL_DOMAIN=.edu,.ac.in,campus.edu

# Storage & Uploads
IMAGE_STORAGE_PROVIDER=local

